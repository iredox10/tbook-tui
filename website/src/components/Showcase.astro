---
---

<section class="section overflow-hidden">
  <div class="container">
    <div class="text-center max-w-2xl mx-auto mb-12">
      <p class="text-sm font-mono text-purple mb-3">SEE IT IN ACTION</p>
      <h2 class="text-4xl sm:text-5xl font-bold mb-5">Your library, reimagined</h2>
      <p class="text-muted text-lg">
        Browse books, resume reading, search inside chapters, and navigate with the keyboard — all without leaving your terminal.
      </p>
    </div>

    <div class="relative max-w-5xl mx-auto">
      <div class="absolute -inset-1 bg-gradient-to-r from-cyan/20 via-purple/20 to-pink/20 rounded-2xl blur-2xl opacity-40"></div>
      <div class="terminal relative">
        <div class="terminal-header">
          <div class="terminal-dot red"></div>
          <div class="terminal-dot yellow"></div>
          <div class="terminal-dot green"></div>
          <span class="ml-3 text-xs text-muted font-mono">tbook-tui — demo</span>
        </div>
        <div class="p-0">
          <img
            src="/demo.gif"
            poster="/demo-poster.png"
            alt="TBook TUI demo showing the terminal book reader interface"
            class="w-full h-auto block"
            loading="lazy"
            width="1200"
            height="675"
          />
        </div>
      </div>
    </div>

    <div class="grid sm:grid-cols-3 gap-6 max-w-4xl mx-auto mt-12">
      <div class="text-center p-5">
        <div class="text-3xl font-bold gradient-text mb-1">15+</div>
        <div class="text-sm text-muted">Supported formats & features</div>
      </div>
      <div class="text-center p-5">
        <div class="text-3xl font-bold gradient-text mb-1">0</div>
        <div class="text-sm text-muted">Context switches to start reading</div>
      </div>
      <div class="text-center p-5">
        <div class="text-3xl font-bold gradient-text mb-1">∞</div>
        <div class="text-sm text-muted">Distraction-free focus</div>
      </div>
    </div>
  </div>
</section>
