{
  "name": "iredox-tbook-tui",
  "version": "1.0.3",
  "description": "A premium terminal book reader built with OpenTUI",
  "type": "module",
  "bin": {
    "tbook-tui": "./index.ts"
  },
  "files": [
    "index.ts",
    "src",
    "README.md",
    "tsconfig.json",
    "package.json"
  ],
  "preferGlobal": true,
  "engines": {
    "bun": ">=1.0.0"
  },
  "scripts": {
    "start": "bun run index.ts",
    "dev": "bun run --watch index.ts"
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "@opentui/core": "^0.1.102",
    "epub2": "^3.0.2",
    "node-html-parser": "^7.1.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.3"
  }
}
